# Local LLM settings — copy to scripts/local_llm.env (gitignored)
#   cp scripts/local_llm.env.example scripts/local_llm.env
#
# Recommended for browser-based Project Tracker deployments:
# the browser calls this app's backend, which calls Deepseek with DEEPSEEK_API_KEY.
LOCAL_LLM_BASE_URL=${PUBLIC_ORIGIN%/}/api/llm
LOCAL_LLM_MODEL=deepseek-chat
LOCAL_LLM_AUTH=none

# Backend .env must include DEEPSEEK_API_KEY. The server uses https://api.deepseek.com
# and model deepseek-chat unless DEEPSEEK_BASE_URL or DEEPSEEK_MODEL is set.
# LLM_PROXY_BASE_URL is the fallback when DEEPSEEK_API_KEY is empty.
#
# Previous HKU IT Vertex AI Qwen example:
# LOCAL_LLM_BASE_URL=https://api.hku.hk/vertexai
# LOCAL_LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct-maas
# LOCAL_LLM_AUTH=apim
#
# Primary subscription key (sent as HTTP header `api-key`, one line, no quotes):
#   secrets/internal_llm_api_key.txt
# Use the IT "primary key" there; keep secondary key for rotation only.
#
# Rate limits (qwen/qwen3-next-80b-a3b-instruct-maas): 5 requests/min, 300/day

# Optional if not using secrets/internal_llm_api_key.txt
# LOCAL_LLM_API_KEY=
